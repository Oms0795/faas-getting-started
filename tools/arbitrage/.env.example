# Configuracion del scanner de arbitraje multi-cadena
# Simulacion por defecto: no firma ni transmite TX reales.
MODO_SIMULACION=true

# Clave privada y contratos (SOLO para produccion; NO usar en simulacion)
PRIVATE_KEY=0x...
CONTRACT_ARBITRUM=0x...
CONTRACT_BASE=0x...
CONTRACT_POLYGON=0x...

# RPC endpoints (obten gratis de Alchemy, Infura, QuickNode o publicos)
HTTP_ARBITRUM=https://arb1.arbitrum.io/rpc
HTTP_BASE=https://mainnet.base.org
HTTP_POLYGON=https://polygon-rpc.com

WSS_ARBITRUM=
WSS_BASE=
WSS_POLYGON=

# Limites y riesgo
LIMITE_DIARIO_USD=5000
MAX_EXPOSICION_TRADE=2000
MAX_PERDIDAS_CONSECUTIVAS=3
COOLDOWN_POST_TRADE=120
MIN_SPREAD_USD=0.50
MAX_SPREAD_SOSPECHOSO=500
MAX_SLIPPAGE_PCT=0.5
FLASHLOAN_AMOUNT_USDC=10000
