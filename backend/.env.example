NEXUS_ENVIRONMENT=development
NEXUS_LOG_LEVEL=INFO
NEXUS_ADMIN_API_KEY=
NEXUS_CORS_ORIGINS=http://localhost:3000
NEXUS_SCAN_INTERVAL_SECONDS=1
NEXUS_SYMBOLS=ETH/USDC,BTC/USDC,SOL/USDC
NEXUS_SIMULATION_EXECUTION_ENABLED=true
NEXUS_LIVE_TRADING_ENABLED=false
NEXUS_MIN_PROFIT_USD=1
NEXUS_MAX_NOTIONAL_USD=10000
NEXUS_MAX_DAILY_LOSS_USD=500
NEXUS_MAX_SLIPPAGE_BPS=30
NEXUS_EXECUTION_COOLDOWN_SECONDS=10
NEXUS_INFRASTRUCTURE_ENABLED=true
NEXUS_DATABASE_URL=postgresql+asyncpg://nexus:nexus@timescaledb:5432/nexus
NEXUS_REDIS_URL=redis://redis:6379/0
NEXUS_NATS_URL=nats://nats:4222
NEXUS_OTLP_ENDPOINT=http://otel-collector:4317
